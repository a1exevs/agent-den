{
  "name": "agent-den",
  "version": "0.0.0",
  "private": true,
  "description": "A living pixel-art den for your AI agents and their subagents",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:plugin": "node scripts/build-plugin.mjs",
    "dev:collector": "npm run dev -w @agent-den/collector",
    "dev:mock": "npm run start -w @agent-den/mock",
    "dev:web": "npm run start -w @agent-den/web",
    "generate:icons": "npm run generate:icons -w @agent-den/web",
    "dev:web:fresh": "node -e \"require('fs').rmSync('apps/web/.angular/cache', { recursive: true, force: true })\" && npm run dev:web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "node scripts/sync-agent-rules.mjs --check && node scripts/check-structure.mjs && node scripts/check-plugin.mjs && prettier --check . && knip && eslint . && npm run lint --workspaces --if-present",
    "lint:structure": "node scripts/check-structure.mjs",
    "lint:unused": "knip",
    "rules:sync": "node scripts/sync-agent-rules.mjs",
    "test": "node --test plugins/claude-code/scripts/version.test.mjs plugins/claude-code/scripts/plugin-paths.test.mjs && npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@alexevs/prettier-config": "1.0.1",
    "@eslint/js": "9.39.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "knip": "6.38.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
