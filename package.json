{
  "name": "agent-den",
  "version": "0.0.0",
  "private": true,
  "description": "A living pixel-art den where your AI agents (and their subagents) are cats",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "dev:web": "npm run start -w @agent-den/web",
    "dev:collector": "npm run dev -w @agent-den/collector",
    "dev:mock": "npm run start -w @agent-den/mock",
    "build": "npm run build --workspaces --if-present",
    "lint": "node scripts/sync-agent-rules.mjs --check && npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "rules:sync": "node scripts/sync-agent-rules.mjs"
  },
  "devDependencies": {
    "@alexevs/prettier-config": "1.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
